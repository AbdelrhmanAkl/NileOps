
APP_NAME=NileOps
APP_ENV=development
APP_DEBUG=false
DATABASE_URL=sqlite:///./data/nileops.db
UPLOAD_DIR=storage
MAX_UPLOAD_SIZE_MB=10

# Authentication
JWT_SECRET_KEY=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15

# OCR (optional; defaults shown)
# TESSERACT_CMD=tesseract
# OCR_LANGUAGES=ara+eng
# OCR_TIMEOUT_SECONDS=60
# OCR_MIN_CONFIDENCE=0.80

# Policy assistant (RAG). LLM_PROVIDER=none keeps answers extractive (no LLM).
# To use a local Qwen: install Ollama, run `ollama pull qwen2.5:7b-instruct`, then set:
# LLM_PROVIDER=ollama
# LLM_BASE_URL=http://localhost:11434
# LLM_MODEL=qwen2.5:7b-instruct
# RAG_MIN_COVERAGE=0.55
# RAG_LLM_MIN_COVERAGE=0.25   # grey zone: only the local LLM may answer (set =0.55 to disable)
