# Copy to deploy/.env.production (never commit it).
APP_ENV=production
APP_DEBUG=false
DOCS_ENABLED=false
ALLOWED_HOSTS=nileops.example.com
DATABASE_URL=sqlite:///./data/nileops.db
UPLOAD_DIR=storage
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
ACCESS_TOKEN_EXPIRE_MINUTES=15
# Optional local LLM (Ollama) for the policy assistant:
# LLM_PROVIDER=ollama
# LLM_BASE_URL=http://ollama:11434
# LLM_MODEL=qwen2.5:7b-instruct
